{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ui-design-lab.local/schemas/suite.schema.json",
  "title": "UI Design Lab Suite Manifest",
  "type": "object",
  "required": [
    "id",
    "order",
    "displayName",
    "localizedName",
    "shortCode",
    "prefix",
    "version",
    "status",
    "platforms",
    "modes",
    "densities",
    "scope",
    "designDocument",
    "tokens",
    "tokensCss",
    "components",
    "showcase"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "order": { "type": "integer", "minimum": 1 },
    "displayName": { "type": "string", "minLength": 2 },
    "localizedName": { "type": "string", "minLength": 2 },
    "shortCode": { "type": "string", "pattern": "^[A-Z0-9]{2,5}$" },
    "prefix": { "type": "string", "pattern": "^[a-z][a-z0-9]{1,5}$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "enum": ["draft", "experimental", "stable", "deprecated"] },
    "platforms": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "modes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "densities": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "swatches": { "type": "array", "minItems": 3, "maxItems": 5, "items": { "type": "string" } },
    "capabilities": { "type": "object" }
  },
  "additionalProperties": true
}
