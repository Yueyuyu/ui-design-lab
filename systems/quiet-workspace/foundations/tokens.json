{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Quiet Workspace",
  "id": "quiet-workspace",
  "version": "0.3.0",
  "prefix": "qw",
  "color": {
    "surface": {
      "paper": { "$type": "color", "$value": "#FCFCFB" },
      "strong": { "$type": "color", "$value": "#FFFFFF" },
      "subtle": { "$type": "color", "$value": "#F1F3F0" },
      "selected": { "$type": "color", "$value": "#E5E9E4" }
    },
    "text": {
      "primary": { "$type": "color", "$value": "#262623" },
      "secondary": { "$type": "color", "$value": "#686A65" },
      "muted": { "$type": "color", "$value": "#73736E" },
      "quiet": { "$type": "color", "$value": "#6F736D" },
      "inverse": { "$type": "color", "$value": "#FFFFFF" }
    },
    "border": {
      "hairline": { "$type": "color", "$value": "#E4E4E0" },
      "strong": { "$type": "color", "$value": "#D7D9D4" }
    },
    "brand": {
      "deep": { "$type": "color", "$value": "#2D5A55" },
      "default": { "$type": "color", "$value": "#477D71" },
      "soft": { "$type": "color", "$value": "#DCE9E4" }
    },
    "status": {
      "attention": { "$type": "color", "$value": "#E87D75" },
      "attentionSoft": { "$type": "color", "$value": "#F7E1DF" },
      "attentionText": { "$type": "color", "$value": "#93413C" },
      "running": { "$type": "color", "$value": "#F0AD4E" },
      "runningSoft": { "$type": "color", "$value": "#F7EAD4" },
      "runningText": { "$type": "color", "$value": "#7C4D0E" },
      "success": { "$type": "color", "$value": "#4D8F65" },
      "successSoft": { "$type": "color", "$value": "#E4F0E7" },
      "successText": { "$type": "color", "$value": "#2F6B43" },
      "offline": { "$type": "color", "$value": "#979993" },
      "offlineSoft": { "$type": "color", "$value": "#ECEDEA" },
      "offlineText": { "$type": "color", "$value": "#5F625D" }
    },
    "chart": {
      "one": { "$type": "color", "$value": "#B8CEC7" },
      "two": { "$type": "color", "$value": "#96B9AE" },
      "three": { "$type": "color", "$value": "#73A397" },
      "four": { "$type": "color", "$value": "#477D71" },
      "five": { "$type": "color", "$value": "#2D5A55" },
      "grid": { "$type": "color", "$value": "#E4E4E0" }
    }
  },
  "fontSize": {
    "caption": { "$type": "dimension", "$value": "11px" },
    "label": { "$type": "dimension", "$value": "12px" },
    "bodySmall": { "$type": "dimension", "$value": "12px" },
    "body": { "$type": "dimension", "$value": "14px" },
    "title": { "$type": "dimension", "$value": "16px" },
    "heading": { "$type": "dimension", "$value": "24px" },
    "display": { "$type": "dimension", "$value": "40px" }
  },
  "lineHeight": {
    "caption": { "$type": "dimension", "$value": "16px" },
    "label": { "$type": "dimension", "$value": "16px" },
    "bodySmall": { "$type": "dimension", "$value": "18px" },
    "body": { "$type": "dimension", "$value": "22px" },
    "title": { "$type": "dimension", "$value": "24px" },
    "heading": { "$type": "dimension", "$value": "32px" },
    "display": { "$type": "dimension", "$value": "48px" }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "20px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "10": { "$type": "dimension", "$value": "40px" },
    "12": { "$type": "dimension", "$value": "48px" }
  },
  "radius": {
    "small": { "$type": "dimension", "$value": "4px" },
    "medium": { "$type": "dimension", "$value": "8px" },
    "large": { "$type": "dimension", "$value": "12px" },
    "xlarge": { "$type": "dimension", "$value": "16px" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "duration": {
    "fast": { "$type": "duration", "$value": "140ms" },
    "normal": { "$type": "duration", "$value": "180ms" },
    "slow": { "$type": "duration", "$value": "240ms" }
  },
  "easing": {
    "out": { "$type": "cubicBezier", "$value": [0.23, 1, 0.32, 1] }
  },
  "density": {
    "comfortable": {
      "controlHeight": { "$type": "dimension", "$value": "40px" },
      "rowHeight": { "$type": "dimension", "$value": "52px" },
      "panelPadding": { "$type": "dimension", "$value": "20px" },
      "inlineGap": { "$type": "dimension", "$value": "12px" }
    },
    "compact": {
      "controlHeight": { "$type": "dimension", "$value": "32px" },
      "rowHeight": { "$type": "dimension", "$value": "40px" },
      "panelPadding": { "$type": "dimension", "$value": "12px" },
      "inlineGap": { "$type": "dimension", "$value": "8px" }
    }
  },
  "icon": {
    "compact": { "$type": "dimension", "$value": "16px" },
    "comfortable": { "$type": "dimension", "$value": "18px" },
    "navigation": { "$type": "dimension", "$value": "20px" },
    "display": { "$type": "dimension", "$value": "24px" }
  },
  "component": {
    "quotaPill": {
      "healthy": {
        "surface": { "$type": "color", "$value": "#F4F9F2" },
        "surfaceHover": { "$type": "color", "$value": "#EFF6ED" },
        "surfacePressed": { "$type": "color", "$value": "#E9F1E6" },
        "border": { "$type": "color", "$value": "#D3E2CF" },
        "text": { "$type": "color", "$value": "#4D6650" }
      },
      "caution": {
        "surface": { "$type": "color", "$value": "#FFF8EB" },
        "surfaceHover": { "$type": "color", "$value": "#FDF4E2" },
        "surfacePressed": { "$type": "color", "$value": "#F9EDD8" },
        "border": { "$type": "color", "$value": "#EDD8B1" },
        "text": { "$type": "color", "$value": "#7A6238" }
      },
      "critical": {
        "surface": { "$type": "color", "$value": "#FFF4F2" },
        "surfaceHover": { "$type": "color", "$value": "#FDEEEB" },
        "surfacePressed": { "$type": "color", "$value": "#F9E7E3" },
        "border": { "$type": "color", "$value": "#EECDC8" },
        "text": { "$type": "color", "$value": "#854C48" }
      },
      "neutral": {
        "surface": { "$type": "color", "$value": "#F7F8F5" },
        "surfaceHover": { "$type": "color", "$value": "#F1F3EF" },
        "surfacePressed": { "$type": "color", "$value": "#EBECE8" },
        "border": { "$type": "color", "$value": "#DFE1DC" },
        "text": { "$type": "color", "$value": "#5F625D" }
      }
    }
  },
  "implementation": {
    "font-sans": { "$type": "string", "$value": "\"Segoe UI Variable\", \"Segoe UI\", \"Microsoft YaHei UI\", system-ui, sans-serif" },
    "font-mono": { "$type": "string", "$value": "\"Cascadia Code\", \"Segoe UI Mono\", ui-monospace, monospace" },
    "shadow-raised": { "$type": "string", "$value": "0 2px 8px rgb(38 53 54 / 12%)" },
    "shadow-floating": { "$type": "string", "$value": "0 20px 56px rgb(5 12 16 / 18%), 0 4px 12px rgb(5 12 16 / 10%)" },
    "shadow-dialog": { "$type": "string", "$value": "0 28px 80px rgb(5 12 16 / 24%), 0 6px 18px rgb(5 12 16 / 12%)" },
    "focus-ring": { "$type": "string", "$value": "0 0 0 3px rgb(71 125 113 / 24%)" }
  },
  "motion": {
    "reducedDuration": { "$type": "duration", "$value": "0ms" }
  }
}
