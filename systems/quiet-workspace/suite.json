      "default": "#477d71"
    },
    {
      "label": "正文颜色",
      "type": "color",
      "role": "text",
      "token": "--qw-color-text-primary",
      "default": "#262623"
    },
    {
      "label": "面板颜色",
      "type": "color",
      "role": "surface",
      "token": "--qw-color-paper",
      "default": "#fcfcfb"
    },
    {
      "label": "圆角",
      "type": "radius",
      "token": "--qw-radius-md",
      "default": "8px"
    },
    {
      "label": "字体",
      "type": "font",
      "token": "--qw-font-sans",
      "default": "\"Segoe UI Variable\", \"Segoe UI\", \"Microsoft YaHei UI\", system-ui, sans-serif",
      "options": [
        "\"Segoe UI Variable\", \"Segoe UI\", \"Microsoft YaHei UI\", system-ui, sans-serif",
        "Inter, \"Segoe UI\", \"Microsoft YaHei UI\", sans-serif",
        "system-ui, sans-serif"
      ]
    }
