{
  "name": "Pulse Desktop",
  "id": "pulse-desktop",
  "version": "0.1.0",
  "prefix": "pd",
  "color": {
    "surface": {
      "$type": "color",
      "$value": "#000000"
    },
    "canvas": {
      "$type": "color",
      "$value": "#151515"
    },
    "ink": {
      "$type": "color",
      "$value": "#FFFFFF"
    },
    "muted": {
      "$type": "color",
      "$value": "#A0A0A0"
    },
    "line": {
      "$type": "color",
      "$value": "#303030"
    },
    "track": {
      "$type": "color",
      "$value": "#2E2E2E"
    },
    "green": {
      "$type": "color",
      "$value": "#00E68C"
    },
    "greenInk": {
      "$type": "color",
      "$value": "#00E68C"
    },
    "greenSoft": {
      "$type": "color",
      "$value": "#103027"
    },
    "amber": {
      "$type": "color",
      "$value": "#FFC226"
    },
    "amberSoft": {
      "$type": "color",
      "$value": "#362B12"
    },
    "red": {
      "$type": "color",
      "$value": "#FF4F42"
    },
    "redSoft": {
      "$type": "color",
      "$value": "#361B18"
    },
    "focus": {
      "$type": "color",
      "$value": "#FFFFFF"
    },
    "spent": {
      "$type": "color",
      "$value": "#D91721"
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "$value": "\"Segoe UI Variable\", \"Segoe UI\", \"Microsoft YaHei UI\", sans-serif"
    },
    "body": {
      "$type": "dimension",
      "$value": "13px"
    },
    "caption": {
      "$type": "dimension",
      "$value": "12px"
    }
  },
  "shape": {
    "card": {
      "$type": "dimension",
      "$value": "20px"
    },
    "pill": {
      "$type": "dimension",
      "$value": "999px"
    }
  },
  "size": {
    "ring": {
      "$type": "dimension",
      "$value": "36px"
    },
    "control": {
      "$type": "dimension",
      "$value": "32px"
    }
  },
  "space": {
    "inset": {
      "$type": "dimension",
      "$value": "18px"
    }
  },
  "motion": {
    "enter": {
      "$type": "duration",
      "$value": "180ms"
    },
    "exit": {
      "$type": "duration",
      "$value": "120ms"
    },
    "ease": {
      "$type": "cubicBezier",
      "$value": [
        0.23,
        1,
        0.32,
        1
      ]
    }
  },
  "elevation": {
    "shadow": {
      "$type": "string",
      "$value": "none"
    }
  }
}
