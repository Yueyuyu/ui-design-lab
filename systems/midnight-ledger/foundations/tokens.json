{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Midnight Ledger",
  "id": "midnight-ledger",
  "version": "0.1.0",
  "prefix": "ml",
  "color": {
    "surface": {
      "canvas": { "$type": "color", "$value": "#1C223A" },
      "panel": { "$type": "color", "$value": "#252A40" },
      "raised": { "$type": "color", "$value": "#20263C" },
      "selected": { "$type": "color", "$value": "#343A54" },
      "ledger": { "$type": "color", "$value": "#E8D8B3" },
      "scrim": { "$type": "color", "$value": "#0D1020" }
    },
    "text": {
      "primary": { "$type": "color", "$value": "#E5D4B6" },
      "secondary": { "$type": "color", "$value": "#C7BEAA" },
      "muted": { "$type": "color", "$value": "#A39E95" },
      "quiet": { "$type": "color", "$value": "#8F8D8A" },
      "onLedger": { "$type": "color", "$value": "#1B2036" },
      "inverse": { "$type": "color", "$value": "#FFFFFF" }
    },
    "border": {
      "hairline": { "$type": "color", "$value": "#45495A" },
      "strong": { "$type": "color", "$value": "#515873" },
      "ledger": { "$type": "color", "$value": "#B6A887" }
    },
    "brand": {
      "default": { "$type": "color", "$value": "#EF5B32" },
      "hover": { "$type": "color", "$value": "#FA714D" },
      "pressed": { "$type": "color", "$value": "#D94B27" },
      "soft": { "$type": "color", "$value": "#663427" }
    },
    "status": {
      "positive": { "$type": "color", "$value": "#9DCE8E" },
      "positiveSoft": { "$type": "color", "$value": "#314737" },
      "negative": { "$type": "color", "$value": "#E57763" },
      "negativeSoft": { "$type": "color", "$value": "#53343A" },
      "warning": { "$type": "color", "$value": "#E8BD68" },
      "warningSoft": { "$type": "color", "$value": "#51462E" },
      "info": { "$type": "color", "$value": "#73BED0" },
      "infoSoft": { "$type": "color", "$value": "#294653" },
      "option": { "$type": "color", "$value": "#BD8DDE" }
    },
    "chart": {
      "line": { "$type": "color", "$value": "#E8D8B3" },
      "positive": { "$type": "color", "$value": "#9DCE8E" },
      "negative": { "$type": "color", "$value": "#E57763" },
      "grid": { "$type": "color", "$value": "#30364D" },
      "baseline": { "$type": "color", "$value": "#515873" }
    },
    "focus": { "ring": { "$type": "color", "$value": "#F3C969" } }
  },
  "fontSize": {
    "caption": { "$type": "dimension", "$value": "11px" },
    "label": { "$type": "dimension", "$value": "12px" },
    "bodySmall": { "$type": "dimension", "$value": "12px" },
    "body": { "$type": "dimension", "$value": "14px" },
    "title": { "$type": "dimension", "$value": "16px" },
    "heading": { "$type": "dimension", "$value": "24px" },
    "display": { "$type": "dimension", "$value": "48px" }
  },
  "lineHeight": {
    "caption": { "$type": "dimension", "$value": "15px" },
    "label": { "$type": "dimension", "$value": "16px" },
    "bodySmall": { "$type": "dimension", "$value": "18px" },
    "body": { "$type": "dimension", "$value": "21px" },
    "title": { "$type": "dimension", "$value": "22px" },
    "heading": { "$type": "dimension", "$value": "30px" },
    "display": { "$type": "dimension", "$value": "52px" }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "20px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "10": { "$type": "dimension", "$value": "40px" }
  },
  "radius": {
    "small": { "$type": "dimension", "$value": "6px" },
    "medium": { "$type": "dimension", "$value": "10px" },
    "large": { "$type": "dimension", "$value": "16px" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "duration": {
    "fast": { "$type": "duration", "$value": "120ms" },
    "normal": { "$type": "duration", "$value": "180ms" },
    "slow": { "$type": "duration", "$value": "260ms" }
  },
  "easing": { "out": { "$type": "cubicBezier", "$value": [0.2, 0.8, 0.2, 1] } },
  "density": {
    "comfortable": {
      "controlHeight": { "$type": "dimension", "$value": "38px" },
      "rowHeight": { "$type": "dimension", "$value": "46px" },
      "panelPadding": { "$type": "dimension", "$value": "16px" },
      "inlineGap": { "$type": "dimension", "$value": "10px" }
    },
    "compact": {
      "controlHeight": { "$type": "dimension", "$value": "32px" },
      "rowHeight": { "$type": "dimension", "$value": "38px" },
      "panelPadding": { "$type": "dimension", "$value": "12px" },
      "inlineGap": { "$type": "dimension", "$value": "8px" }
    }
  },
  "icon": {
    "compact": { "$type": "dimension", "$value": "15px" },
    "comfortable": { "$type": "dimension", "$value": "17px" },
    "navigation": { "$type": "dimension", "$value": "19px" },
    "display": { "$type": "dimension", "$value": "24px" }
  }
}
