  "shortCode": "ML",
  "prefix": "ml",
  "componentPrefix": "Ledger",
  "version": "0.1.0",
  "status": "experimental",
  "description": "深蓝与奶油文字构成的数据设计，适合分析、监控与运营报表。",
  "styleLabel": "Nocturnal Financial Console",
  "platforms": [
    "web",
    "desktop"
  ],
  "modes": [
    "dark"
  ],
  "densities": [
    "comfortable",
    "compact"
  ],
  "tags": [
    "dark",
    "financial",
    "dense",
    "terminal",
    "data-rich"
  ],
  "swatches": [
    "#171B2E",
    "#E8D8B3",
    "#9DCE8E",
    "#EF5B32",
    "#E57763"
  ],
  "galleryShell": {
    "surface": "#171B2E",
    "sidebar": "#13182A",
    "topbar": "#171B2E",
    "text": "#E8D8B3",
    "muted": "#A49D93",
    "border": "#30364D",
    "active": "#242B45",
    "accent": "#F26A32",
    "onAccent": "#171B2E"
  },
  "referenceImage": "references/midnight-ledger-source.png",
  "referenceImages": [
    "references/midnight-ledger-source.png",
    "references/midnight-ledger-compact-source.png",
    "references/midnight-ledger-live-source.png"
  ],
  "scope": "[data-ui-system=\"midnight-ledger\"]",
  "designDocument": "./DESIGN.md",
  "tokens": "./foundations/tokens.json",
  "tokensCss": "./foundations/tokens.css",
  "components": "./web/index.js",
