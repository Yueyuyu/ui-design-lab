    "patterns": [
      "portfolio-overview",
      "compact-trade-console",
      "signal-cockpit",
      "position-ledger",
      "calendar-heatmap",
      "terminal-preview",
      "shell"
    ],
    "standards": [
      "accessibility",
      "component-states",
      "icons",
      "data-visualization",
      "chinese-copy",
      "motion",
      "status-semantics",
      "composition",
      "extension"
    ]
  },
  "comparison": {
    "entry": "./comparison/index.jsx",
    "scenarios": [
      "monthly-review",
      "data-table",
      "settings-form",
      "detail-page",
      "empty-state"
    ],
    "modules": [
      "metrics",
      "chart",
      "form",
      "buttons"
    ]
  },
  "selection": {
    "suitableFor": [
      "数据分析与运营台",
      "高密度监控与报表"
    ],
    "limitations": [
      "实验阶段，API 可能调整",
      "暂未提供浅色模式"
    ],
    "previewKind": "scene-concept",
    "thumbnail": "references/thumbnails/midnight-ledger.png",
    "summary": "让复杂信息，一眼有序。",
    "scenePreview": {
      "image": "references/scene-covers/midnight-ledger.png",
      "title": "交易工作台"
    }
  },
  "tokenBindings": "./foundations/token-bindings.json",
  "themeControls": [
    {
      "label": "品牌色",
      "type": "color",
      "role": "brand",
      "token": "--ml-brand",
      "default": "#ef5b32"
    },
    {
      "label": "正文颜色",
      "type": "color",
      "role": "text",
      "token": "--ml-text-primary",
      "default": "#e5d4b6"
    },
    {
      "label": "面板颜色",
      "type": "color",
      "role": "surface",
      "token": "--ml-surface-panel",
      "default": "#252a40"
    },
    {
      "label": "圆角",
      "type": "radius",
      "token": "--ml-radius-md",
      "default": "10px"
    },
    {
      "label": "字体",
      "type": "font",
      "token": "--ml-font-ui",
      "default": "Inter, \"Segoe UI\", \"Microsoft YaHei UI\", sans-serif",
      "options": [
        "\"Segoe UI Variable\", \"Segoe UI\", \"Microsoft YaHei UI\", system-ui, sans-serif",
        "Inter, \"Segoe UI\", \"Microsoft YaHei UI\", sans-serif",
        "system-ui, sans-serif"
      ]
    }
  ]
}
