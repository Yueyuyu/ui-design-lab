{
  "id": "dialogue-ui",
  "name": "Dialogue UI",
  "prefix": "du",
  "version": "0.1.0",
  "base": {
    "canvas": {
      "$type": "color",
      "$value": "#ffffff"
    },
    "surface": {
      "$type": "color",
      "$value": "#ffffff"
    },
    "sidebar": {
      "$type": "color",
      "$value": "#f9f9f9"
    },
    "text": {
      "$type": "color",
      "$value": "#202020"
    },
    "muted": {
      "$type": "color",
      "$value": "#656565"
    },
    "border": {
      "$type": "color",
      "$value": "#dedede"
    },
    "accent": {
      "$type": "color",
      "$value": "#202020"
    },
    "on-accent": {
      "$type": "color",
      "$value": "#ffffff"
    },
    "soft": {
      "$type": "color",
      "$value": "#f0f0f0"
    },
    "error": {
      "$type": "color",
      "$value": "#b42318"
    },
    "success": {
      "$type": "color",
      "$value": "#237346"
    },
    "font": {
      "$type": "string",
      "$value": "system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", \"Microsoft YaHei UI\", sans-serif"
    },
    "font-size": {
      "$type": "string",
      "$value": "14px"
    },
    "line-height": {
      "$type": "string",
      "$value": "1.55"
    },
    "radius": {
      "$type": "string",
      "$value": "20px"
    },
    "panel-radius": {
      "$type": "string",
      "$value": "24px"
    },
    "control-height": {
      "$type": "string",
      "$value": "40px"
    },
    "control-x": {
      "$type": "string",
      "$value": "14px"
    },
    "row-gap": {
      "$type": "string",
      "$value": "16px"
    },
    "motion": {
      "$type": "string",
      "$value": "140ms"
    },
    "space-1": {
      "$type": "string",
      "$value": "4px"
    },
    "space-2": {
      "$type": "string",
      "$value": "8px"
    },
    "space-3": {
      "$type": "string",
      "$value": "12px"
    },
    "space-4": {
      "$type": "string",
      "$value": "16px"
    },
    "space-6": {
      "$type": "string",
      "$value": "24px"
    }
  },
  "compact": {
    "control-height": {
      "$type": "dimension",
      "$value": "34px"
    },
    "row-gap": {
      "$type": "dimension",
      "$value": "10px"
    }
  },
  "reducedMotion": {
    "duration": {
      "$type": "duration",
      "$value": "0ms"
    }
  }
}
