  "tokenBindings": "./foundations/token-bindings.json",
  "components": "./web/index.js",
  "showcase": "./showcase/index.jsx",
  "capabilities": {
    "foundations": [
      "color",
      "typography",
      "spacing",
      "shape",
      "density",
      "motion"
