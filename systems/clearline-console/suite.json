    "components": [
      "button",
      "field",
      "select",
      "toggle",
      "panel",
      "badge",
      "bar-chart",
      "shell",
      "data-table",
      "textarea",
      "checkbox",
      "radio-group",
      "combobox",
      "multi-select",
      "date-picker",
      "date-range",
      "tabs",
      "breadcrumb",
      "pagination",
      "dropdown-menu",
      "tooltip",
      "popover",
      "drawer",
      "progress",
      "skeleton",
      "toast-queue"
    ],
    "patterns": [
      "project-workbench",
      "task-workflow"
    ],
    "standards": [
      "accessibility",
      "component-states",
      "icons",
      "data-visualization",
      "chinese-copy",
      "motion"
    ]
  },
  "comparison": {
    "entry": "./comparison/index.jsx",
    "scenarios": [
      "monthly-review",
      "data-table",
      "settings-form",
      "detail-page",
      "empty-state"
    ],
    "modules": [
      "metrics",
      "chart",
      "form",
      "buttons"
    ]
  },
  "selection": {
    "suitableFor": [
      "企业后台与项目管理",
      "数据表格与表单"
    ],
    "limitations": [
      "新增实验套系，API 可能调整",
      "仅浅色；暂未提供上传与目录树"
    ],
    "previewKind": "components",
    "thumbnail": "references/thumbnails/clearline-console.png"
  },
  "themeControls": [
    {
      "label": "品牌色",
      "type": "color",
      "role": "brand",
      "token": "--cc-brand",
      "default": "#2457d6"
    },
    {
      "label": "正文颜色",
      "type": "color",
      "role": "text",
      "token": "--cc-text",
      "default": "#18243b"
    },
    {
      "label": "面板颜色",
      "type": "color",
      "role": "surface",
      "token": "--cc-surface",
      "default": "#ffffff"
    },
    {
      "label": "圆角",
      "type": "radius",
      "token": "--cc-radius",
      "default": "6px"
    },
    {
      "label": "字体",
      "type": "font",
      "token": "--cc-font",
      "default": "\"Segoe UI\", \"Microsoft YaHei UI\", sans-serif",
      "options": [
        "\"Segoe UI\", \"Microsoft YaHei UI\", sans-serif",
        "system-ui, sans-serif"
      ]
    }
  ]
}
