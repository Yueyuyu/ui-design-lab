{
  "$schema": "../../schemas/suite.schema.json",
  "id": "clearline-console",
  "order": 3,
  "displayName": "Clearline Console",
  "localizedName": "澄明后台",
  "shortCode": "CC",
  "prefix": "cc",
  "componentPrefix": "Clear",
  "version": "0.1.0",
  "status": "experimental",
  "description": "清爽、对齐严谨的企业后台，专注项目、表格、权限与设置。",
  "styleLabel": "Clear Enterprise Operations",
  "platforms": [
    "web",
    "desktop"
  ],
  "modes": [
    "light"
  ],
  "densities": [
    "comfortable",
    "compact"
  ],
  "tags": [
    "enterprise",
    "admin",
    "table",
    "forms"
  ],
  "swatches": [
    "#f3f5f8",
    "#2457d6",
    "#18243b",
    "#ffffff"
  ],
  "galleryShell": {
    "surface": "#f3f5f8",
    "sidebar": "#ffffff",
    "topbar": "#ffffff",
    "text": "#18243b",
    "muted": "#5e6b80",
    "border": "#d7dee8",
    "active": "#f3f5f8",
    "accent": "#2457d6",
    "onAccent": "#ffffff"
  },
  "referenceImage": "references/clearline-console-source.png",
  "scope": "[data-ui-system=\"clearline-console\"]",
  "designDocument": "./DESIGN.md",
  "tokens": "./foundations/tokens.json",
