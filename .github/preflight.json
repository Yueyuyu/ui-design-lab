{
  "version": 1,
  "required": [
    ".github/scripts/preflight.mjs",
    ".github/scripts/preflight.checks.mjs",
    ".githooks/pre-commit",
    ".githooks/pre-push",
    ".github/scripts/change-scope.test.mjs",
    ".github/scripts/change-scope.mjs",
    ".githooks/.gitattributes"
  ],
  "packageScripts": [
    "package.json"
  ],
  "checks": [
    [
      "node",
      "--test",
      ".github/scripts/preflight.checks.mjs"
    ],
    [
      "node",
      "--test",
      ".github/scripts/change-scope.test.mjs"
    ]
  ],
  "programChecks": [
    [
      "npm",
      "run",
      "check"
    ],
    [
      "npm",
      "run",
      "test:sites"
    ],
    [
      "npm",
      "run",
      "test:consumer"
    ]
  ],
  "documentation": {
    "rootMarkdown": true,
    "files": [
      "LICENSE",
      ".github/CI.md",
      ".github/pull_request_template.md"
    ],
    "markdownDirectories": [
      "docs/",
      "design-recipes/"
    ],
    "runtimeDocuments": [
      "QUICKSTART.md"
    ]
  },
  "generated": {},
  "excludedWorkflows": {}
}
